# ─────────────────────────────────────────────
# DATABASE — copy to .env and .env.local
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/myevents_db?schema=public"

# ─────────────────────────────────────────────
# AUTH — generate secret with: npx auth secret
# ─────────────────────────────────────────────
AUTH_SECRET="your-generated-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="My Events"
NEXT_PUBLIC_INVITATION_BASE_URL="http://localhost:3001/i"
